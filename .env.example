
FLASK_ENV=development

# Replace this with a long, random secret before deployment
SECRET_KEY=replace-with-a-long-random-secret

# Use 0 for local development; use 1 in production with HTTPS
SESSION_COOKIE_SECURE=0

# TiDB / MySQL database connection
DB_HOST=localhost
DB_PORT=4000
DB_USER=your_tidb_user
DB_PASSWORD=your_tidb_password
DB_NAME=smartbill_new

# Optional: path to TiDB CA certificate
DB_SSL_CA=

# Optional SMTP for email verification and password reset.
# Configure a provider before enabling email-dependent account workflows.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=1
MAIL_USE_SSL=0
